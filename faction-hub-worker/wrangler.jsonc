      "preview_id": "5816dbbee4d54384b8382fa872fd8c47"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FACTION_ROOM",
        "class_name": "FactionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FactionRoom"]
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://zkyhfchwwwbsvwceeqdi.supabase.co"
  }
}